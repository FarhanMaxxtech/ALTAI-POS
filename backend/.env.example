# Copy this file to .env and fill in real values. Never commit .env.
PORT=3001
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=altai_pos_dev
DB_USER=altai_app
DB_PASSWORD=change-me

# Team's RFID / stock API (altairfid). Ask the team for a key issued for the POS.
ALTAI_API_BASE_URL=https://altairfid.com/rest
ALTAI_API_KEY=
ALTAI_MERCHANT_ID=1
ALTAI_API_TIMEOUT_MS=8000
